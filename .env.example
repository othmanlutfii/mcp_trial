# ============================================================
#  Salin file ini menjadi `.env` lalu isi API key provider pilihan Anda.
#      cp .env.example .env
#  Hanya provider yang dipakai (SECBOT_PROVIDER) yang perlu diisi.
# ============================================================

# ---------- Pilih provider: ollama | gemini | deepseek ----------
SECBOT_PROVIDER=ollama

# ---------- Ollama (lokal, tanpa API key; perlu `ollama serve`) ----------
SECBOT_OLLAMA_URL=http://localhost:11434
SECBOT_LLM_MODEL=qwen3:latest
SECBOT_EMBED_MODEL=bge-m3:latest

# ---------- Google Gemini (ada free tier) ----------
# API key: https://aistudio.google.com/apikey
SECBOT_GEMINI_API_KEY=
SECBOT_GEMINI_MODEL=gemini-3.5-flash-lite
SECBOT_GEMINI_EMBED_MODEL=gemini-embedding-001

# ---------- DeepSeek (OpenAI-compatible) ----------
# API key: https://platform.deepseek.com/api_keys
# Catatan: DeepSeek tidak menyediakan API embedding, jadi embedding tetap
# memakai Ollama (default) atau Gemini (set SECBOT_EMBED_PROVIDER=gemini).
SECBOT_DEEPSEEK_API_KEY=
SECBOT_DEEPSEEK_MODEL=deepseek-flash

# ---------- Umum ----------
SECBOT_TEMPERATURE=0
# true = aktifkan mode berpikir/penalaran (lebih lambat & lebih boros kuota)
SECBOT_THINKING=false
# Paksa provider embedding: ollama | gemini (kosong = ikut provider chat)
# SECBOT_EMBED_PROVIDER=

# ---------- Tenable Security Center (Finding VA pada assessment koneksi) ----------
# URL host Tenable.sc; endpoint /rest/analysis ditambahkan otomatis.
TENABLE_BASE_URL=https://IPXXXX
ACCESS_KEY=
SECRET_KEY=
# Opsional: path ke trusted CA bundle PEM untuk sertifikat internal Tenable.
# Pilihan yang disarankan: gunakan CA bundle agar validasi TLS tetap aktif.
TENABLE_CA_BUNDLE=
# true (default) memverifikasi sertifikat; false melewati verifikasi TLS (berisiko).
TENABLE_VERIFY_TLS=true
TENABLE_CONNECT_TIMEOUT=5
TENABLE_READ_TIMEOUT=30

# ---------- Splunk asset sync ----------
# Host Splunk harus menggunakan HTTPS. Port REST API default Splunk adalah 8089.
SPLUNK_HOST=https://splunk.example.internal
SPLUNK_PORT=8089
SPLUNK_TOKEN=
SPLUNK_VERIFY_TLS=true
# Opsional: CA internal PEM jika sertifikat Splunk tidak ditandatangani CA publik.
SPLUNK_CA_BUNDLE=
SPLUNK_CONNECT_TIMEOUT=5
SPLUNK_READ_TIMEOUT=30
SPLUNK_JOB_TIMEOUT=300
SPLUNK_POLL_INTERVAL=2
# Pisahkan kredensial aplikasi dari token Splunk. Gunakan nilai rahasia yang kuat.
SPLUNK_ASSETS_READ_TOKEN=
SPLUNK_ASSETS_SYNC_TOKEN=
SPLUNK_ASSETS_UI_USERNAME=
SPLUNK_ASSETS_UI_PASSWORD=
# Opsional; default: data/splunk_assets.sqlite3
# SPLUNK_ASSETS_DB_PATH=
